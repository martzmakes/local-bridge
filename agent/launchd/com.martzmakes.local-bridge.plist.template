<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Per-user LaunchAgent for the Local Bridge agent. A LaunchAgent, not a
  LaunchDaemon: the Keychain and every privacy permission the local servers
  need belong to the login session.

  Rendered by scripts/render-plist.sh, which replaces:
    @NODE@   absolute path of the node binary (privacy grants attach to it)
    @AGENT@  absolute path of the bundled agent.mjs
    @HOME@   the user's home directory
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.martzmakes.local-bridge</string>

  <key>ProgramArguments</key>
  <array>
    <string>@NODE@</string>
    <string>@AGENT@</string>
  </array>

  <key>WorkingDirectory</key>
  <string>@HOME@</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ExitTimeOut</key>
  <integer>20</integer>

  <!-- Automation prompts and the login Keychain need a GUI session. -->
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/local-bridge/agent.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/local-bridge/agent.err.log</string>
</dict>
</plist>
